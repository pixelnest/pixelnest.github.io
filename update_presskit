#!/usr/bin/env bash
set -euo pipefail

# The presskit uses the build branch for its published version (see .gitmodules).
# Make sure the submodule is checked out before touching it.
git submodule update --init presskit

# Update.
cd presskit/
git checkout build
git pull --rebase=merges

# Commit.
cd ..
git add presskit/
git commit --message "Update presskit"
